OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional. If OPENAI_API_KEY is set, ChangeScout uses the LLM only to summarize
# already-extracted before/after text. Capture and classification remain deterministic.

# Optional SMTP alerts. Monitoring and reports continue when these are blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional public application URL included in alert emails.
APP_BASE_URL=

# Optional IANA timezone for displayed UI and email times; defaults to UTC.
DISPLAY_TIMEZONE=

# Optional persistent runtime storage root for SQLite and screenshots.
# Railway persistent volume example: /data
DATA_DIR=

# How often the single-process scheduler looks for due monitors.
SCHEDULER_POLL_SECONDS=60