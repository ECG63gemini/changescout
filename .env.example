OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional. If OPENAI_API_KEY is set, ChangeScout uses the LLM only to summarize
# already-extracted before/after text. Capture and classification remain deterministic.

# Optional SMTP alerts and inquiry notifications. Monitoring, reports, and
# inquiry storage continue when these are blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Optional operator recipient for new landing-page inquiry notifications.
INQUIRY_NOTIFICATION_EMAIL=

# Required for operator access at /app. Use an ASCII username (no colon) and
# a long, randomly generated password. Keep both private; use HTTPS in production.
# When either is blank, operator access is disabled (503); monitoring still runs.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional public site origin included in alert emails, without /app.
# Example: https://changescout.example.com -> /app/target/{id}
APP_BASE_URL=

# Optional IANA timezone for displayed UI and email times; defaults to UTC.
DISPLAY_TIMEZONE=

# Optional persistent runtime storage root for SQLite and screenshots.
# Railway persistent volume example: /data
DATA_DIR=

# How often the single-process scheduler looks for due monitors.
SCHEDULER_POLL_SECONDS=60